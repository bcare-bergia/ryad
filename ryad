    podman image inspect -f "base image: {{ index .Labels \"$LBL.base-image\" }}
apps: {{ index .Labels \"$LBL.apps\" }}
built by: ryad {{ or (index .Labels \"$LBL.launcher\") \"(before bundles)\" }}" "$img"
    exit 0 ;;

  list)
    [ ${#POS[@]} -eq 0 ] || die "usage: $PROG list [-q]"
    rows=$(env_rows)
    if [ "$QUIET" = 1 ]; then [ -z "$rows" ] || cut -f1 <<<"$rows"; exit 0; fi
    [ -n "$rows" ] || { echo "no environments (create one with: $PROG NAME --workspace=DIR)"; exit 0; }
    {
      printf 'NAME\tSTATE\tPROFILE\tWORKSPACE\tIMAGE\n'
      while IFS=$'\t' read -r n s p w i o; do
        printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$s" "$p" "$w" "$i$([ "$o" = 0 ] || echo ' *')"
      done <<<"$rows"
    } | column -t -s "$T"
    if grep -q "${T}1\$" <<<"$rows"; then echo "* outdated: $PROG recreate --outdated"; fi
    exit 0 ;;

  info)
    [ ${#POS[@]} -le 1 ] || die "usage: $PROG info [NAME]"
    if [ ${#POS[@]} -eq 1 ]; then
      n=${POS[0]}; check_envs "$n"
    else
      find_env "$(realpath -e -- "$PWD")" "" 0
      n=$MATCH
      [ -n "$n" ] || die "no environment for this folder (see: $PROG list)"
      inspect_env "$n"
    fi
    img=${ENV[image]}
    if env_outdated; then img+="  (outdated: $PROG recreate $n)"; fi
    printf '%-10s %s\n' \
      name "$n  (${ENV[state]}, created ${ENV[created]})" \
      container "$(cname "$n")" \
      profile "${ENV[profile]}  ($(tilde "$PROFILES_DIR/${ENV[profile]}"))" \
      workspace "$(tilde "${ENV[workspace]}")" \
      image "$img" \
      user "${ENV[user]:-claude}@${ENV[hostname]:-$n}" \
      display "${ENV[display]}, gpu $([ "${ENV[gpu]}" = 1 ] && echo on || echo off)"
    exit 0 ;;

  stop)
    if [ "$ALL" = 1 ]; then
      mapfile -t POS < <(env_names)
      [ ${#POS[@]} -gt 0 ] || { note "no environment is running"; exit 0; }
    fi
    [ ${#POS[@]} -gt 0 ] || die "usage: $PROG stop NAME... | --all"
    check_envs "${POS[@]}"
    for n in "${POS[@]}"; do
      if running "$n"; then
        podman stop -t 10 "$(cname "$n")" >/dev/null
        note "stopped '$n'"
      else
        note "'$n' was not running"
      fi
    done
    exit 0 ;;

  rm)
    [ ${#POS[@]} -gt 0 ] || die "usage: $PROG rm NAME... [--force]"
    [ "$YES" = 0 ] || FORCE=1
    check_envs "${POS[@]}"
    if [ "$FORCE" = 0 ]; then
      for n in "${POS[@]}"; do
        running "$n" && die "'$n' is running; stop it first or use --force"
      done
    fi
    for n in "${POS[@]}"; do
      running "$n" && podman stop -t 10 "$(cname "$n")" >/dev/null
      podman rm "$(cname "$n")" >/dev/null
      note "removed '$n' (profile and workspace untouched)"
    done
    exit 0 ;;

  recreate)
    if [ "$OUTDATED" = 1 ] || [ "$ALL" = 1 ]; then
      [ ${#POS[@]} -eq 0 ] || die "give either a NAME or --outdated/--all"
      [ -z "$PROFILE$WORKSPACE" ] || die "--profile and --workspace change one environment at a time: $PROG recreate NAME --profile=..."
      recreate_many "$ALL"
    else
      [ ${#POS[@]} -eq 1 ] || die "usage: $PROG recreate NAME [options] | --outdated | --all"
      n=${POS[0]}
      check_envs "$n"
      [ -z "$PROFILE" ] || check_profile "$PROFILE"
      recreate_settings "$n"
      if [ "$YES" = 0 ]; then
        chg() { [ "$2" = "$3" ] || printf '  %-10s %s -> %s%s\n' "$1" "$2" "$3" "${4:-}"; }
        echo "Recreate '$n'$([ "${ENV[state]}" != running ] || echo ' (running: its shells and apps will be closed)')?"
        chg profile "${ENV[profile]}" "$R_P" "   (other logins, settings and history)"
        chg workspace "$(tilde "${ENV[workspace]}")" "$(tilde "$R_W")"
        if [ "${ENV[image]}" != "$R_I" ]; then chg image "${ENV[image]}" "$R_I"
        elif env_outdated; then printf '  %-10s %s\n' image "$R_I (newer build)"; fi
        chg display "${ENV[display]}" "$R_D"
        chg gpu "${ENV[gpu]}" "$R_G"
        chg user "${ENV[user]:-claude}" "$R_U"
        chg hostname "${ENV[hostname]:-$n}" "$R_H"
        echo "Changes made inside the container (e.g. packages installed with sudo) are lost;"
        echo "the profile and workspace folders are kept."
