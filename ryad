  prune)
    [ ${#POS[@]} -eq 0 ] || die "usage: $PROG prune [--yes]"
    # Images built by "ryad build" (or derived from one) carry $LBL.code-version.
    used=" $(podman ps -a --format '{{.ImageID}}' | cut -c1-12 | tr '\n' ' ') "
    declare -A tags=() size=() keep=()
    while IFS=$'\t' read -r id tag sz v; do
      [ -n "$v" ] || continue
      id=${id:0:12}
      case $tag in *:latest) keep[$id]=1 ;; esac
      [[ $used == *" $id "* ]] && keep[$id]=1
      [ "$tag" = "<none>:<none>" ] || tags[$id]+="${tags[$id]:+ }$tag"
      size[$id]=$sz
    done < <(podman images --format "{{.ID}}$T{{.Repository}}:{{.Tag}}$T{{.Size}}$T$(lbl code-version)")
    ids=()
    for id in "${!size[@]}"; do [ -n "${keep[$id]:-}" ] || ids+=("$id"); done
    [ ${#ids[@]} -gt 0 ] || { note "no unused ryad images"; exit 0; }
    if [ "$YES" = 0 ]; then
      echo "Unused ryad images:"
      for id in "${ids[@]}"; do printf '  %-40s %s\n' "${tags[$id]:-<none> ($id)}" "${size[$id]}"; done
    fi
    confirm "Remove them?"
    for id in "${ids[@]}"; do
      # Untag one by one (removing the last tag removes the image); by ID if untagged.
      for t in ${tags[$id]:-$id}; do
        podman rmi "$t" >/dev/null || note "could not remove $t"
      done
    done
    note "removed ${#ids[@]} image(s)"
    exit 0 ;;
esac

# --- enter (default) -----------------------------------------------------------------------
[ ${#POS[@]} -le 1 ] || die "too many arguments: ${POS[*]} (see --help; a command goes after --)"
[ "$DETACH" = 0 ] || [ ${#RUN[@]} -gt 0 ] || die "--detach needs a command: $PROG [NAME] -d -- CMD"
EXPLICIT_NAME=0
if [ ${#POS[@]} -eq 1 ]; then
  NAME=${POS[0]}; EXPLICIT_NAME=1
  exists "$NAME" || check_name "$NAME"   # existing ones may predate a reserved word
else
  # No name: the environment of this folder or, without --workspace, of the
  # closest parent folder (on --profile, if given).
  if [ -n "$WORKSPACE" ]; then
    dir=$(resolve_workspace "$WORKSPACE"); find_env "$dir" "$PROFILE" 1
  else
    dir=$(realpath -e -- "$PWD"); find_env "$dir" "$PROFILE" 0
  fi
  NAME=$MATCH
fi

if [ -n "$NAME" ] && exists "$NAME"; then
  # Existing environment: its settings are fixed.
  if [ -n "$PROFILE" ] && [ "$PROFILE" != "$(label "$NAME" profile)" ]; then
    die "'$NAME' uses profile '$(label "$NAME" profile)', not '$PROFILE' (to change it: $PROG recreate $NAME --profile=$PROFILE)"
  fi
  if [ -n "$WORKSPACE" ] && [ "$(resolve_workspace "$WORKSPACE")" != "$(label "$NAME" workspace)" ]; then
    die "'$NAME' uses workspace $(label "$NAME" workspace) (to move it: $PROG recreate $NAME --workspace=$WORKSPACE; or pick another name)"
  fi
  if [ -n "$CLI_IMAGE$CLI_DISPLAY$CLI_GPU$CLI_USER$CLI_HOST" ]; then
    note "--image/--display/--no-gpu/--user/--hostname only apply when creating; to change them: $PROG recreate $NAME --image=… --user=…"
  fi
else
  # New environment (or the default name derived from the workspace).
  CONFIRM=0
  if [ "$EXPLICIT_NAME" = 1 ] && [ -z "$WORKSPACE" ]; then
    # Maybe a typo, or meant for another folder: don't create it silently in $PWD.
    similar=$(similar_envs "$NAME")
    note "no environment '$NAME'${similar:+ (did you mean: $similar?)}"
    [ -t 0 ] || [ "$YES" = 1 ] || die "to create it: $PROG $NAME --workspace=DIR"
    CONFIRM=1
  fi
  WS=$(resolve_workspace "${WORKSPACE:-$PWD}")
  if [ -z "$NAME" ]; then
    NAME=$(basename "$WS" | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9_-]+/-/g; s/^[^a-z0-9]+//')
    [ -n "$NAME" ] || NAME=env
    valid_name "$NAME" || NAME="env-$NAME"
  fi
  if exists "$NAME"; then
    # Default name already taken: only reuse it if it's the same workspace.
    if [ "$EXPLICIT_NAME" = 0 ] && [ "$(label "$NAME" workspace)" != "$WS" ]; then
      die "environment '$NAME' already exists for $(label "$NAME" workspace); give this one a name: $PROG <name> --workspace=$WS"
    fi
    [ -z "$PROFILE" ] || [ "$PROFILE" = "$(label "$NAME" profile)" ] \
      || die "'$NAME' uses profile '$(label "$NAME" profile)', not '$PROFILE'"
  else
    PROFILE=${PROFILE:-default}
    check_profile "$PROFILE"
    [ "$CONFIRM" = 0 ] || confirm "Create '$NAME' for $(tilde "$WS"), profile $PROFILE$([ -d "$PROFILES_DIR/$PROFILE" ] || echo ' (new)')?"
    # Creation defaults from the profile, overridden by command-line flags.
    load_profile_conf "$PROFILE"
    U=${CLI_USER:-$USER_NAME}
    if [ -z "$U" ]; then
      U=$(id -un)
      valid_user "$U" || { note "your user name '$U' can't be used inside; using 'claude' (choose one with --user=NAME)"; U=claude; }
    fi
    create_env "$NAME" "$PROFILE" "$WS" "${CLI_IMAGE:-${IMAGE:-$DEFAULT_IMAGE}}" \
      "${CLI_DISPLAY:-${DISPLAY_MODE:-auto}}" "${CLI_GPU:-${GPU:-1}}" "$U" "${CLI_HOST:-${HOST_NAME:-$NAME}}"
  fi
fi

start_env "$NAME"     # ENV now holds its fresh state and labels
C=$(cname "$NAME") PDIR=$PROFILES_DIR/${ENV[profile]}

# A display mode chosen at creation that doesn't fit this session.
detect_display
case ${ENV[display]} in
  none) [ "$HAVE_WL$HAVE_X" = 00 ] \
          || note "'$NAME' was created without a display, so GUI apps won't work in it (to fix: $PROG recreate $NAME)" ;;
  wayland) [ $HAVE_WL = 1 ] || [ $HAVE_X = 0 ] \
          || note "'$NAME' uses Wayland but this session has none; GUI apps won't work (to use X11: $PROG recreate $NAME --display=x11)" ;;
  x11) [ $HAVE_X = 1 ] || [ $HAVE_WL = 0 ] \
          || note "'$NAME' uses X11 but this session has no X display; GUI apps won't work (to use Wayland: $PROG recreate $NAME --display=wayland)" ;;
esac

# Open in the current folder if it's inside the workspace, else at its top.
ws=${ENV[workspace]} wd=$(realpath -e -- "$PWD" 2>/dev/null || true)
case $wd/ in "${ws%/}"/*) ;; *) wd=$ws ;; esac
exec_args=(-w "$wd")
# Re-read at each enter, so edits apply to new shells.
[ -f "$PDIR/profile.env" ] && exec_args+=(--env-file "$PDIR/profile.env")
[ -n "${TERM:-}" ] && exec_args+=(-e "TERM=$TERM")
[ -n "${COLORTERM:-}" ] && exec_args+=(-e "COLORTERM=$COLORTERM")
[ -n "${RYAD_ELECTRON_NO_SANDBOX:-}" ] && exec_args+=(-e "RYAD_ELECTRON_NO_SANDBOX=$RYAD_ELECTRON_NO_SANDBOX")
load_profile_conf "${ENV[profile]}"
PROMPT_COLORS=${RYAD_PROMPT_COLORS:-$PROMPT_COLORS}
[ -n "$PROMPT_COLORS" ] && exec_args+=(-e "RYAD_PROMPT_COLORS=$PROMPT_COLORS")
# The X display number can change between logins.
[ "${ENV[display]}" != none ] && [ -n "${DISPLAY:-}" ] && exec_args+=(-e "DISPLAY=$DISPLAY")

if [ "$DETACH" = 1 ]; then
  # In the background: output to ~/$LOGDIR/<cmd>.log, exit status to <cmd>.status.
  app=$(basename -- "${RUN[0]}"); app=${app//[^A-Za-z0-9_.-]/_}
  log=$PDIR/home/$LOGDIR/$app.log st=$PDIR/home/$LOGDIR/$app.status
  rm -f "$st"
  start=$(stat -c %s "$log" 2>/dev/null || echo 0)   # where this run's output begins
  podman exec -d "${exec_args[@]}" "$C" bash -c '
    d=$HOME/'"$LOGDIR"'; mkdir -p "$d"
    printf "== %s: %s\n" "$(date "+%F %T")" "$*" >>"$d/$0.log"
    "$@" >>"$d/$0.log" 2>&1; echo $? >"$d/$0.status"' "$app" "${RUN[@]}" >/dev/null
  # Report a command that fails right away (e.g. an app already open elsewhere).
  for _ in $(seq 10); do [ -e "$st" ] && break; sleep 0.1; done
  if [ -e "$st" ] && [ "$(cat "$st")" != 0 ]; then
    note "$app exited with status $(cat "$st"); its output (in $(tilde "$log")):"
    tail -c +$((start + 1)) "$log" | tail -n 20 >&2
    exit 1
  fi
  note "started $app in '$NAME' (log: $(tilde "$log"))"
  exit 0
fi

[ ${#RUN[@]} -gt 0 ] || RUN=(bash -l)
if [ -t 0 ] && [ -t 1 ]; then
  exec podman exec -it "${exec_args[@]}" "$C" "${RUN[@]}"
else
  exec podman exec -i "${exec_args[@]}" "$C" "${RUN[@]}"
fi
